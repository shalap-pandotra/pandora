{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pandora",
  "version": "0.1.0",
  "identifier": "com.shalap.Pandora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pandora",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data: blob:",
        "media-src": "blob:",
        "connect-src": "ipc: http://ipc.localhost book: http://book.localhost",
        "frame-src": "blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol":{
        "enable": true,
        "scope": ["**/cover.jpg"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
