{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the library window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "allow-set-library-path",
    "allow-get-authors",
    "allow-get-series",
    "allow-get-tags",
    "allow-get-books-filtered",
    "allow-get-multi-text-columns",
    "allow-get-comments",
    "allow-get-next-series-index",
    "allow-save-metadata-batch",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-get-custom-editor",
    "allow-get-edit-extras",
    "allow-preview-cover",
    "allow-save-last-library-path",
    "allow-load-last-library-path",
    "allow-open-book"
  ]
}
